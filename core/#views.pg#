/* ── Google Font ─────────────────────────────────────── */
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono&display=swap');

/* ── Reset ───────────────────────────────────────────── */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

/* ── Base ────────────────────────────────────────────── */
body {
    font-family: 'DM Sans', sans-serif;
    background: #f0f2f5;
    color: #1a1a2e;
}

/* ══════════════════════════════════════════════════════
   LOGIN PAGE
══════════════════════════════════════════════════════ */
.login-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #1a3c5e, #2e86c1);
}

.login-card {
    background: white;
    border-radius: 12px;
    padding: 2.5rem;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.15);
}

.login-logo {
    display: block;
    width: 90px;
    height: auto;
    margin: 0 auto 1rem;
}

/* ══════════════════════════════════════════════════════
   DASHBOARD LAYOUT
══════════════════════════════════════════════════════ */
.dashboard-layout {
    display: flex;
    min-height: 100vh;
}

/* ── Sidebar ─────────────────────────────────────────── */
.sidebar {
    width: 230px;
    min-height: 100vh;
    color: white;
    position: fixed;
    top: 0;
    left: 0;
    padding: 1.5rem 0;
    z-index: 100;
}

/* Each role has its own sidebar colour */
.sidebar.admin   { background: #0f1f3d; }
.sidebar.teacher { background: #1a3a2e; }
.sidebar.student { background: #2c1f4a; }

.sidebar-brand {
    text-align: center;
    padding: 0 1rem 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 1rem;
}

.brand-icon { font-size: 2rem; }
.brand-text { font-size: 1.2rem; font-weight: 700; }
.brand-sub  { font-size: 0.7rem; color: rgba(255,255,255,0.4); }

/* Admin = gold, Teacher = green, Student = purple */
.sidebar.admin   .brand-text { color: #f0c040; }
.sidebar.teacher .brand-text { color: #7dcea0; }
.sidebar.student .brand-text { color: #c39bd3; }

.sidebar-section-label {
    font-size: 0.65rem;
    color: rgba(255,255,255,0.3);
    letter-spacing: 2px;
    padding: 1rem 1.5rem 0.4rem;
    text-transform: uppercase;
}

.sidebar-nav { padding: 0 0.75rem; }

.nav-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    color: rgba(255,255,255,0.65);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 2px;
    transition: all 0.2s;
}

.nav-link:hover { background: rgba(255,255,255,0.08); color: white; }

.sidebar.admin   .nav-link.active { background: #2e86c1; }
.sidebar.teacher .nav-link.active { background: #27ae60; }
.sidebar.student .nav-link.active { background: #8e44ad; }
.nav-link.active { color: white; font-weight: 600; }

.logout-link { color: #ff6b6b !important; margin-top: 0.5rem; }
.logout-link:hover { background: rgba(255,107,107,0.15) !important; }

/* ── Main Content ────────────────────────────────────── */
.main-content {
    margin-left: 230px;
    flex: 1;
    padding: 2rem;
}

/* ── Top Bar ─────────────────────────────────────────── */
.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: white;
    border-radius: 12px;
    padding: 1.2rem 1.8rem;
    margin-bottom: 1.8rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.page-title    { font-size: 1.5rem; font-weight: 700; color: #0f1f3d; }
.page-subtitle { font-size: 0.88rem; color: #666; margin-top: 2px; }
.top-bar-right { display: flex; align-items: center; gap: 1rem; }

.date-chip {
    background: #f0f2f5;
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
    font-size: 0.82rem;
    color: #555;
}

.avatar {
    width: 38px; height: 38px;
    border-radius: 50%;
    color: white;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700;
}

.avatar.admin   { background: #2e86c1; }
.avatar.teacher { background: #27ae60; }
.avatar.student { background: #8e44ad; }

/* ── Alert ───────────────────────────────────────────── */
.alert-banner {
    padding: 0.8rem 1.2rem;
    border-radius: 8px;
    margin-bottom: 1.2rem;
    background: #fff3cd;
    color: #856404;
}

/* ── Stat Cards ──────────────────────────────────────── */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin-bottom: 1.8rem;
}

.stat-card {
    background: white;
    border-radius: 12px;
    padding: 1.4rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    border-top: 4px solid transparent;
    transition: transform 0.2s;
}

.stat-card:hover   { transform: translateY(-3px); }
.stat-card.blue    { border-top-color: #2e86c1; }
.stat-card.green   { border-top-color: #27ae60; }
.stat-card.orange  { border-top-color: #e67e22; }
.stat-card.red     { border-top-color: #e74c3c; }
.stat-card.purple  { border-top-color: #8e44ad; }

.stat-icon   { font-size: 1.8rem; margin-bottom: 0.5rem; }
.stat-number { font-size: 2.2rem; font-weight: 700; font-family: 'DM Mono', monospace; color: #0f1f3d; }
.stat-label  { font-size: 0.85rem; color: #666; margin-top: 2px; }

/* ── Two Column Grid ─────────────────────────────────── */
.two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    margin-bottom: 1.8rem;
}

/* ── Panel ───────────────────────────────────────────── */
.panel {
    background: white;
    border-radius: 12px;
    padding: 1.4rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    margin-bottom: 1.8rem;
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
}

.panel-title { font-size: 0.95rem; font-weight: 600; color: #0f1f3d; }
.panel-link  { font-size: 0.8rem; text-decoration: none; }
.panel-link.admin   { color: #2e86c1; }
.panel-link.teacher { color: #27ae60; }
.panel-link.student { color: #8e44ad; }

/* ── Quick Actions ───────────────────────────────────── */
.quick-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    margin-bottom: 1rem;
}

.action-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: #f0f2f5;
    border-radius: 8px;
    color: #0f1f3d;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s;
}

.action-btn:hover         { color: white; }
.action-btn.admin:hover   { background: #2e86c1; }
.action-btn.teacher:hover { background: #27ae60; }
.action-btn.student:hover { background: #8e44ad; }

/* ── Table ───────────────────────────────────────────── */
.data-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
.data-table th { background: #f0f2f5; padding: 0.6rem 0.8rem; text-align: left; font-size: 0.75rem; color: #666; text-transform: uppercase; }
.data-table td { padding: 0.65rem 0.8rem; border-bottom: 1px solid #f0f2f5; }
.data-table tr:last-child td { border-bottom: none; }
.empty-row { text-align: center; color: #aaa; padding: 1.5rem !important; }

/* ── Badges ──────────────────────────────────────────── */
.badge { padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
.badge-green  { background: #d4edda; color: #155724; }
.badge-red    { background: #f8d7da; color: #721c24; }
.badge-orange { background: #fff3cd; color: #856404; }

/* ── Timetable Items ─────────────────────────────────── */
.timetable-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem;
    border-radius: 8px;
    margin-bottom: 0.7rem;
}

.timetable-item.admin   { background: #f0f6ff; border-left: 3px solid #2e86c1; }
.timetable-item.teacher { background: #f8fffe; border-left: 3px solid #27ae60; }
.timetable-item.student { background: #fdf8ff; border-left: 3px solid #8e44ad; }

.slot-time    { font-family: 'DM Mono', monospace; font-size: 0.78rem; color: #555; min-width: 90px; }
.slot-subject { font-weight: 600; font-size: 0.9rem; }
.slot-class   { font-size: 0.78rem; color: #888; }
.empty-state  { text-align: center; color: #aaa; padding: 1.5rem; }

/* ── Attendance Bars ─────────────────────────────────── */
.att-row { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem; }
.att-label { width: 55px; font-size: 0.82rem; color: #555; }
.att-bar-wrap { flex: 1; background: #f0f2f5; border-radius: 6px; height: 10px; overflow: hidden; }
.att-bar { height: 100%; border-radius: 6px; }
.att-bar.green  { background: #27ae60; }
.att-bar.red    { background: #e74c3c; }
.att-bar.orange { background: #e67e22; }
.att-pct { font-size: 0.82rem; font-weight: 600; width: 36px; text-align: right; }

/* Attendance dots (student dashboard) */
.att-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.att-dot.green  { background: #27ae60; }
.att-dot.red    { background: #e74c3c; }
.att-dot.orange { background: #e67e22; }
.att-text  { flex: 1; font-size: 0.85rem; color: #555; }
.att-count { font-size: 0.85rem; font-weight: 600; }

/* ── Fee Summary ─────────────────────────────────────── */
.fee-row { display: flex; justify-content: space-between; margin-bottom: 0.8rem; }
.fee-label { font-size: 0.88rem; color: #555; }
.fee-value { font-size: 1rem; font-weight: 700; font-family: 'DM Mono', monospace; }
.fee-divider { border-top: 1px dashed #e0e0e0; margin-bottom: 0.8rem; }
.green-text { color: #27ae60; }
.red-text   { color: #e74c3c; }

.fee-status { text-align: center; padding: 0.6rem; border-radius: 8px; font-weight: 600; font-size: 0.88rem; }
.fee-status.paid  { background: #d4edda; color: #155724; }
.fee-status.owing { background: #f8d7da; color: #721c24; }

/* ── Grade Rows ──────────────────────────────────────── */
.grade-row { display: flex; align-items: center; padding: 0.7rem 0; border-bottom: 1px solid #f0f2f5; }
.grade-row:last-child { border-bottom: none; }
.grade-subject { flex: 1; font-weight: 500; }
.grade-term    { font-size: 0.78rem; color: #888; margin-right: 1rem; }
.grade-score   { display: flex; align-items: center; gap: 0.5rem; }
.grade-letter  { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem; }
.grade-a { background: #d4edda; color: #155724; }
.grade-b { background: #cce5ff; color: #004085; }
.grade-c { background: #fff3cd; color: #856404; }
.grade-d { background: #ffe0b2; color: #bf360c; }
.grade-f { background: #f8d7da; color: #721c24; }
.grade-num { font-family: 'DM Mono', monospace; font-size: 0.85rem; color: #555; }

/* ── Class Info Box (Teacher) ────────────────────────── */
.class-info-box { background: #f0fff6; border-radius: 10px; padding: 1rem; border: 1px solid #c3e6cb; margin-top: 1rem; }
.class-info-title { font-size: 0.75rem; color: #27ae60; font-weight: 600; margin-bottom: 0.4rem; }
.class-info-name  { font-size: 1.2rem; font-weight: 700; color: #0f1f3d; }
.class-info-meta  { font-size: 0.82rem; color: #666; }

/* ── Table Action Link ───────────────────────────────── */
.table-action { text-decoration: none; font-size: 0.82rem; font-weight: 600; }
.table-action.admin   { color: #2e86c1; }
.table-action.teacher { color: #27ae60; }
.table-action.student { color: #8e44ad; }

/* ══════════════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════════════ */
@media (max-width: 1024px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .two-col    { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
    .sidebar      { display: none; }
    .main-content { margin-left: 0; padding: 1rem; }
    .stats-grid   { grid-template-columns: repeat(2, 1fr); }
}